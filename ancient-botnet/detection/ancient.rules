# Suricata/Snort rules for the Ancient botnet C2 protocol.
# The bot opens its C2 session with the 4 ASCII bytes "ANCT" as the first client payload,
# then switches to an encrypted stream. See:
# https://github.com/ksi-digital/threat-research/tree/main/ancient-botnet
#
# SIDs use a private range (9,000,000+). Tune/enable per your environment.

# 1. The "ANCT" handshake tag at the start of an outbound TCP stream (protocol-generic; not port-locked).
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"KSI Ancient botnet C2 handshake (ANCT tag)"; flow:established,to_server; dsize:4; content:"ANCT"; depth:4; threshold:type limit,track by_src,count 1,seconds 300; classtype:trojan-activity; reference:url,github.com/ksi-digital/threat-research/tree/main/ancient-botnet; sid:9000001; rev:1;)

# 2. Known Ancient C2 endpoint observed 2026-10-05 (IP rotates - treat as a dated indicator, not permanent).
alert tcp $HOME_NET any -> 89.163.157.131 35342 (msg:"KSI Ancient botnet C2 connection (89.163.157.131:35342)"; flow:to_server; classtype:trojan-activity; reference:url,threatfox.abuse.ch/browse.php?search=ioc%3A89.163.157.131; sid:9000002; rev:1;)

# 3. Payload server observed serving the dropper and per-arch bot builds (dated).
alert http $HOME_NET any -> 89.163.157.131 8080 (msg:"KSI Ancient botnet payload download"; flow:to_server; http.uri; content:"persist.sh"; classtype:trojan-activity; reference:url,urlhaus.abuse.ch/browse.php?search=89.163.157.131; sid:9000003; rev:1;)
